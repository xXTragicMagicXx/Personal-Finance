<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:text="Finance" android:textColor="@color/w_mute" android:textSize="13sp" />

    <TextView android:id="@+id/w_total" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum" android:maxLines="1" android:text="—" android:textColor="@color/w_ink"
        android:textSize="28sp" android:textStyle="bold" />

    <TextView android:id="@+id/w_change" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="2" android:textColor="@color/w_mute" android:textSize="13sp" android:textStyle="bold" />

    <TextView android:id="@+id/w_cash" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:maxLines="1" android:textColor="@color/w_ink" android:textSize="13sp"
        android:visibility="gone" />

    <TextView android:id="@+id/w_due" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:maxLines="1" android:textColor="@color/w_acc" android:textSize="13sp"
        android:textStyle="bold" android:visibility="gone" />

    <LinearLayout android:id="@+id/w_goalrow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/w_goal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_mute" android:textSize="12sp" />
        <ProgressBar android:id="@+id/w_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp"
            android:max="100" android:progressTint="@color/w_up" android:progressBackgroundTint="@color/w_mute" />
    </LinearLayout>
</LinearLayout>
